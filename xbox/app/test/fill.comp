// test_dozen.cpp's compute program: out[i] = i * 3 + push.add, through Dozen's SPIR-V to DXIL compiler.
//     glslangValidator -V --target-env vulkan1.3 --vn kFillSpv -o fill_spv.h fill.comp
#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) buffer Out { uint v[]; } outb;
layout(push_constant) uniform Push { uint add; } push;
void main() {
    uint i = gl_GlobalInvocationID.x;
    outb.v[i] = i * 3u + push.add;
}
