#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_scalar_block_layout : require
// uint8 indices to uint32, including indices written earlier in this command buffer.
// glslangValidator -V --target-env vulkan1.2 --vn U8_WIDEN_COMP_SPV -o u8_widen_comp_spv.h u8_widen.comp
layout(local_size_x = 64) in;
layout(buffer_reference, scalar) readonly buffer Words { uint w[]; };
layout(buffer_reference, scalar) writeonly buffer Outs { uint w[]; };
layout(push_constant, scalar) uniform P {
    Words src;
    Outs dst;
    uint count;
    uint restart;
    uint src_byte;
    uint pad;
} pc;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;
    uint at = pc.src_byte + i;
    uint word = pc.src.w[at >> 2u];
    uint v = (word >> ((at & 3u) * 8u)) & 0xFFu;
    pc.dst.w[i] = (pc.restart != 0u && v == 255u) ? 0xFFFFFFFFu : v;
}
